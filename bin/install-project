#!/usr/bin/env bash
# Activate an isolated library and register its entry point in the adopter's workspace.
set -euo pipefail
source_args=()
answer_args=()
progress=
# Each answer to a setup question travels to setup unchanged; setup asks the next missing question.
while [[ ${1:-} == --* ]]; do
  [[ -n ${2:-} ]] || { echo "$1 needs a value" >&2; exit 2; }
  case $1 in
    --start)
      [[ $2 == example || $2 == empty ]] || { echo 'expected --start example or empty' >&2; exit 2; }
      source_args+=(--start "$2") ;;
    --wiki)
      [[ -d $2 ]] || { echo 'select an existing wiki directory' >&2; exit 2; }
      source_args+=(--wiki "$(cd -- "$2" && pwd -P)") ;;
    --database)
      [[ $2 == sqlite || $2 == postgres ]] || { echo 'expected --database sqlite or postgres' >&2; exit 2; }
      answer_args+=(--database "$2") ;;
    --database-secret-file)
      [[ -f $2 ]] || { echo 'select an existing database secret file' >&2; exit 2; }
      answer_args+=(--database-secret-file "$(cd -- "$(dirname -- "$2")" && pwd -P)/$(basename -- "$2")") ;;
    --memory)
      answer_args+=(--memory "$2") ;;
    --progress)
      [[ $2 == json ]] || { echo 'expected --progress json' >&2; exit 2; }
      progress=json ;;
    --shelf)
      if [[ $2 == none ]]; then
        answer_args+=(--shelf none)
      else
        [[ -d $2 ]] || { echo 'select an existing shelf folder, or --shelf none' >&2; exit 2; }
        answer_args+=(--shelf "$(cd -- "$2" && pwd -P)")
      fi ;;
    *) echo "unknown option $1" >&2; exit 2 ;;
  esac
  shift 2
done
if (( $# < 1 || $# > 2 )); then
  echo 'usage: bin/install-project [--start example|empty | --wiki DIR] [--database sqlite|postgres] [--database-secret-file FILE] [--memory SIZE] [--shelf DIR|none] [--progress json] EXISTING_WORKSPACE [CONFIRMED_COMPOSE_PROFILE.json]' >&2
  exit 2
fi
repo=$(cd -- "$(dirname -- "$0")/.." && pwd -P)
# With --progress json, standard output carries one JSON event per line; everything else goes to standard error.
steps=5 step=0 step_id= started=$(date +%s)
if [[ $progress == json ]]; then exec 3>&1 1>&2; fi
emit() { if [[ $progress == json ]]; then printf '%s\n' "$1" >&3; fi; }
begin() {
  step=$((step + 1)) step_id=$1
  emit "$(jq -cn --argjson step "$step" --argjson steps "$steps" --arg id "$1" --arg label "$2" \
    --argjson elapsed "$(( $(date +%s) - started ))" \
    '{event:"step",step:$step,steps:$steps,id:$id,label:$label,elapsed:$elapsed}')"
}
failed() {
  emit "$(jq -cn --argjson step "$step" --arg id "$step_id" --argjson exit "$1" \
    '{event:"error",step:$step,id:$id,exit:$exit}')"
}
trap 'failed $?' ERR
workspace=$(cd -- "$1" && pwd -P)
if [[ $workspace == / || $workspace == "$(cd ~ && pwd -P)" ]]; then
  echo 'select a project directory' >&2; exit 2
fi
state=$workspace/.benedict
[[ ! -L $state ]] || { echo 'refusing a linked settings directory' >&2; exit 2; }
if (( $# == 2 )); then
  profile=$(cd -- "$(dirname -- "$2")" && pwd -P)/$(basename -- "$2")
  project=$(jq -er '.name | strings | select(test("^[a-z0-9][a-z0-9_-]*$"))' "$profile")
else
  profile=$state/profile.json
  if [[ -L $profile ]]; then echo 'refusing a linked profile' >&2; exit 2; fi
  if [[ -f $profile ]]; then
    project=$(jq -er '.name | strings | select(test("^[a-z0-9][a-z0-9_-]*$"))' "$profile")
  else
    # Keep the installation identity across repeat installs, independent of the checkout name.
    project=benedict-$(od -An -N12 -tx1 /dev/urandom | tr -d ' \n')
  fi
fi
if [[ -f $profile ]] && (( ${#source_args[@]} + ${#answer_args[@]} )); then
  echo 'This project already has a profile. Use that profile or choose a new workspace.' >&2
  exit 2
fi
if [[ ! -f $profile && ${#source_args[@]} -eq 0 ]]; then
  printf '%s\n' '어떤 자료로 시작할까요? 기존 위키 폴더 경로 / 예제로 시작(example) / 빈 도서관(empty)' >&2
  if [[ ! -t 0 ]]; then echo 'Pass the user’s choice with --wiki DIR or --start example|empty.' >&2; exit 2; fi
  IFS= read -r answer || exit 2
  case "$answer" in
    example|empty) source_args=(--start "$answer") ;;
    *) [[ -n $answer && -d $answer ]] || { echo 'expected a wiki directory, example, or empty' >&2; exit 2; }
       source_args=(--wiki "$(cd -- "$answer" && pwd -P)") ;;
  esac
fi
mkdir -p -- "$state"
if [[ ! -e $state/.gitignore && ! -L $state/.gitignore ]]; then printf '*\n' >"$state/.gitignore"; fi
mkdir -- "$state/install.lock" || { echo 'another installation holds the project lock' >&2; exit 1; }
stage=$state/install.lock
trap 'rm -f -- "$stage/library" "$stage/AGENTS.md" "$stage/CLAUDE.md" "$stage/GEMINI.md" "$stage/profile.json"; rmdir -- "$stage"' EXIT
image=${LIBRARY_IMAGE:-$project-library}
base=$repo/compose.yaml
start='<!-- Benedict project instructions -->'
end='<!-- End Benedict project instructions -->'
for name in AGENTS.md CLAUDE.md GEMINI.md; do
  file=$workspace/$name
  [[ ! -L $file && ( ! -e $file || -f $file ) ]] || { echo "cannot safely update $file" >&2; exit 2; }
  if [[ -f $file ]]; then
    cp -p -- "$file" "$stage/$name"
    if grep -Fxq -e "$start" -e "$end" "$file"; then
      awk -v start="$start" -v end="$end" -v guide="$repo/docs/install/workspace.md" '
        $0 == start {
          if (seen++) exit 2
          inside=1; print
          while ((getline line < guide) > 0) print line
          close(guide); next
        }
        $0 == end { if (!inside) exit 2; inside=0 }
        !inside { print }
        END { if (inside || !seen) exit 2 }
      ' "$file" >"$stage/$name" || { echo "invalid Benedict markers in $file" >&2; exit 2; }
      continue
    fi
  fi
  { printf '\n%s\n' "$start"; cat "$repo/docs/install/workspace.md"; printf '%s\n' "$end"; } >>"$stage/$name"
done
{
  printf '%s\n' '#!/usr/bin/env bash' 'set -euo pipefail'
  printf 'project=%q\n' "$project"
  cat <<'ENTRY'
# Agents running in this installation's library container use its native client.
if [[ ${LIBRARY_PROJECT:-} == "$project" && -S ${LIBRARY_ROOM_SOCKET:-/nonexistent} ]] && command -v benedict >/dev/null; then
  exec benedict "$@"
fi
ENTRY
  # The room container is always running; send each command into it instead of starting a new container.
  printf 'exec docker exec -i %q benedict "$@"\n' "$project-room-1"
} >"$stage/library"
chmod 755 "$stage/library"
if [[ -L $state/library || ( -e $state/library && ! -f $state/library ) ]]; then
  echo 'refusing an unmanaged entry point' >&2; exit 2
elif [[ -f $state/library ]] && ! cmp -s "$stage/library" "$state/library"; then
  echo 'existing entry point uses different installation settings; use its original checkout and profile' >&2; exit 2
fi
begin image "Building the library image"
docker build --quiet --tag "$image" "$repo"
begin profile "Writing the installation profile"
if (( $# == 1 )) && [[ ! -e $profile ]]; then
  docker run --rm --user "$(id -u):$(id -g)" -v "$stage:/settings" "$image" setup --project "$project" "${source_args[@]}" "${answer_args[@]}" --output /settings/profile.json
  mv -- "$stage/profile.json" "$profile"
fi
export LIBRARY_IMAGE="$image"
compose=(docker compose -p "$project" -f "$base" -f "$profile")
begin room "Starting the room service"
"${compose[@]}" up -d --no-build --wait room
begin index "Indexing the wiki"
activation=$("${compose[@]}" run --rm -T library setup --activate)
printf '%s\n' "$activation"
begin finish "Adding project instructions"
mv -- "$stage/library" "$state/library"
for name in AGENTS.md CLAUDE.md GEMINI.md; do
  if [[ ! -f $workspace/$name ]] || ! cmp -s "$stage/$name" "$workspace/$name"; then
    mv -- "$stage/$name" "$workspace/$name"
  fi
done
printf 'Benedict is ready in %s\n' "$workspace"
emit "$(jq -cn --argjson steps "$steps" --argjson elapsed "$(( $(date +%s) - started ))" \
  --arg workspace "$workspace" --arg project "$project" --argjson activation "${activation:-null}" \
  '{event:"done",steps:$steps,elapsed:$elapsed,workspace:$workspace,project:$project,documents:($activation.index.documents // null)}')"
